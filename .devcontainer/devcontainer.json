{
  "name": "Tommy-House local project",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",              // Python拡張機能
        "ms-azuretools.vscode-docker",   // Docker管理
        "mhutchie.git-graph",            // Git Graph
        "eamodio.gitlens",               // GitLens
        "cline.bot"
      ],
      "settings": {
        "github.copilot.enable": {
          "*": true,
          "dotenv": false,
          "plaintext": false
        }
      }
    }
  },

  "forwardPorts": [3000, 8080],

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/ieietommy/.ssh,type=bind,consistency=cached"
  ],

}
